{
  "$description": "Pebble design tokens (ADR-0035; source: docs/design/web-settings-handoff.md). Semantic names only; every colour has light and dark.",
  "color": {
    "surface": { "light": "#faf1ee", "dark": "#1c1219" },
    "surface-raised": { "light": "#ffffff", "dark": "#281a24" },
    "text": { "light": "#2a1823", "dark": "#f6e9f0" },
    "text-muted": { "light": "#6a4f5e", "dark": "#c4a9b8" },
    "border": { "light": "#967a89", "dark": "#8e7282" },
    "divider": { "light": "#ead3dc", "dark": "#402e3a" },
    "primary": { "light": "#8a2f63", "dark": "#f0a0cb" },
    "primary-contrast": { "light": "#ffffff", "dark": "#3a0f27" },
    "danger": { "light": "#b42318", "dark": "#ffa399" },
    "danger-soft": { "light": "#fde4e0", "dark": "#4b1f1b" },
    "success": { "light": "#23683d", "dark": "#92d8a6" },
    "success-soft": { "light": "#e0f1e3", "dark": "#1d3a26" },
    "focus": { "light": "#0b5fc2", "dark": "#9cc4ff" }
  },
  "font": {
    "sans": "\"Figtree\", system-ui, \"Segoe UI\", sans-serif",
    "display": "\"Bricolage Grotesque\", \"Trebuchet MS\", system-ui, sans-serif"
  },
  "fontFaces": [
    {
      "family": "Bricolage Grotesque",
      "file": "./fonts/bricolage-grotesque/BricolageGrotesque-latin.woff2",
      "weight": "500 700"
    },
    {
      "family": "Figtree",
      "file": "./fonts/figtree/Figtree-latin.woff2",
      "weight": "400 700"
    }
  ],
  "radius": { "pill": "999px", "control": "14px", "card": "24px" },
  "shadow": { "soft": "0 6px 24px -8px rgba(60, 20, 45, 0.28)" },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem"
  },
  "fontSize": {
    "sm": "0.875rem",
    "md": "1rem",
    "lg": "1.25rem",
    "xl": "1.5625rem",
    "2xl": "2rem"
  },
  "motion": {
    "duration": { "press": "200ms", "enter": "250ms" },
    "ease": { "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)" },
    "reducedDuration": "0ms"
  },
  "textPairs": [
    ["text", "surface"],
    ["text", "surface-raised"],
    ["text-muted", "surface"],
    ["text-muted", "surface-raised"],
    ["primary-contrast", "primary"],
    ["danger", "danger-soft"],
    ["success", "success-soft"],
    ["danger", "surface"],
    ["success", "surface"]
  ],
  "edgePairs": [
    ["border", "surface"],
    ["border", "surface-raised"],
    ["focus", "surface"],
    ["focus", "surface-raised"],
    ["primary", "surface"]
  ]
}
