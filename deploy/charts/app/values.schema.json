{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "environment",
    "api",
    "web",
    "ingress",
    "podDisruptionBudget",
    "networkPolicy",
    "certAlert"
  ],
  "definitions": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "image",
        "replicas",
        "port",
        "resources",
        "autoscaling"
      ],
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1025,
          "maximum": 65535
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "not": {
              "pattern": "^[Aa][Pp][Pp]_([Ee][Nn][Vv][Ii][Rr][Oo][Nn][Mm][Ee][Nn][Tt]|[Dd][Aa][Tt][Aa][Bb][Aa][Ss][Ee]_.*|[Tt][Rr][Uu][Ss][Tt][Ee][Dd]_[Pp][Rr][Oo][Xx][Yy]_.*|.*_[Pp][Ee][Rr]_.*|[Cc][Oo][Dd][Ee][Ss]_[Pp][Ee][Rr]_[Hh][Oo][Uu][Rr]|[Mm][Aa][Xx]_[Aa][Tt][Tt][Ee][Mm][Pp][Tt][Ss]|[Rr][Aa][Tt][Ee]_.*|[Oo][Pp][Ee][Nn]_[Ll][Oo][Gg][Ii][Nn]_.*|[Ll][Ii][Vv][Ee]_.*|[Ll][Oo][Gg][Ii][Nn]_[Rr][Ee][Qq][Uu][Ee][Ss][Tt][Ss]_.*|[Bb][Oo][Dd][Yy]_[Ll][Ii][Mm][Ii][Tt]_[Bb][Yy][Tt][Ee][Ss]|[Cc][Oo][Dd][Ee]_[Tt][Tt][Ll]_[Ss][Ee][Cc][Oo][Nn][Dd][Ss]|[Rr][Ee][Ss][Ee][Nn][Dd]_[Cc][Oo][Oo][Ll][Dd][Oo][Ww][Nn]_[Ss][Ee][Cc][Oo][Nn][Dd][Ss]|[Ii][Dd][Ll][Ee]_[Ss][Ee][Cc][Oo][Nn][Dd][Ss]|[Aa][Bb][Ss][Oo][Ll][Uu][Tt][Ee]_[Ss][Ee][Cc][Oo][Nn][Dd][Ss])$"
            }
          }
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            }
          }
        },
        "autoscaling": {
          "type": "object",
          "required": [
            "enabled",
            "minReplicas",
            "maxReplicas",
            "targetCPUUtilizationPercentage"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "not": {
        "const": 443
      }
    },
    "hostCidr": {
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})/(2[4-9]|3[0-2])$",
      "not": {
        "pattern": "^0\\.0\\.0\\.0/"
      }
    }
  },
  "properties": {
    "environment": {
      "enum": [
        "local",
        "staging",
        "production"
      ]
    },
    "api": {
      "allOf": [
        {
          "$ref": "#/definitions/component"
        },
        {
          "required": [
            "config"
          ],
          "properties": {
            "replicas": {
              "const": 1
            },
            "autoscaling": {
              "properties": {
                "enabled": {
                  "const": false
                },
                "minReplicas": {
                  "maximum": 1
                },
                "maxReplicas": {
                  "maximum": 1
                }
              }
            },
            "config": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "username",
                "emailAddress",
                "publicOrigin",
                "noticeIntervalMinutes",
                "smtp",
                "trustedProxyCidrs",
                "trustedProxyHops"
              ],
              "properties": {
                "username": {
                  "type": "string",
                  "minLength": 1
                },
                "emailAddress": {
                  "type": "string",
                  "pattern": "^[^@\\s]+@[^@\\s]+$"
                },
                "publicOrigin": {
                  "type": "string",
                  "pattern": "^https://[a-z0-9.-]+(:[0-9]+)?$"
                },
                "noticeIntervalMinutes": {
                  "type": "integer",
                  "minimum": 1
                },
                "smtp": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "host",
                    "port",
                    "from"
                  ],
                  "properties": {
                    "host": {
                      "type": "string",
                      "minLength": 1
                    },
                    "port": {
                      "$ref": "#/definitions/port"
                    },
                    "from": {
                      "type": "string",
                      "pattern": "^[^@\\s]+@[^@\\s]+$"
                    }
                  }
                },
                "trustedProxyCidrs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
                  },
                  "uniqueItems": true
                },
                "trustedProxyHops": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      ]
    },
    "web": {
      "$ref": "#/definitions/component"
    },
    "ingress": {
      "type": "object",
      "required": [
        "enabled",
        "host",
        "localDomainSuffix",
        "clusterIssuer",
        "tls",
        "hsts",
        "hstsAnnotation"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "localDomainSuffix": {
                "const": "localhost"
              }
            }
          },
          "then": {
            "properties": {
              "host": {
                "pattern": "\\.localhost$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "localDomainSuffix": {
                "const": "local"
              }
            }
          },
          "then": {
            "properties": {
              "host": {
                "pattern": "\\.local$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "localDomainSuffix": {
                "const": "lan"
              }
            }
          },
          "then": {
            "properties": {
              "host": {
                "pattern": "\\.lan$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "localDomainSuffix": {
                "const": "home.arpa"
              }
            }
          },
          "then": {
            "properties": {
              "host": {
                "pattern": "\\.home\\.arpa$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "localDomainSuffix": {
                "const": "internal"
              }
            }
          },
          "then": {
            "properties": {
              "host": {
                "pattern": "\\.internal$"
              }
            }
          }
        }
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
        },
        "localDomainSuffix": {
          "enum": [
            "localhost",
            "local",
            "lan",
            "home.arpa",
            "internal"
          ]
        },
        "clusterIssuer": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "letsencrypt|acme"
          }
        },
        "tls": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "enum": [
                true
              ]
            }
          }
        },
        "hsts": {
          "enum": [
            true
          ]
        },
        "hstsAnnotation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^\\S+$",
              "description": "The annotation that carries the HSTS header; the mechanism is controller specific and must not be empty."
            },
            "format": {
              "type": "string",
              "pattern": "^[^%]*%s[^%]*$",
              "not": {
                "pattern": "includeSubDomains|preload"
              }
            }
          },
          "required": [
            "key",
            "format"
          ]
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "controllerConfig": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": [
        "minAvailable"
      ]
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled",
        "ingressController",
        "egress"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressController": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "podLabels"
          ],
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "podLabels": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "database",
            "smtp"
          ],
          "properties": {
            "database": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cidr",
                "port"
              ],
              "properties": {
                "cidr": {
                  "$ref": "#/definitions/hostCidr"
                },
                "port": {
                  "$ref": "#/definitions/port"
                }
              }
            },
            "smtp": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cidr"
              ],
              "properties": {
                "cidr": {
                  "$ref": "#/definitions/hostCidr"
                }
              }
            }
          }
        }
      }
    },
    "certAlert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "daysAhead"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "daysAhead": {
          "type": "integer",
          "minimum": 14
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "ingress"
        ],
        "properties": {
          "ingress": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "api": {
            "properties": {
              "config": {
                "properties": {
                  "trustedProxyCidrs": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "environment"
        ],
        "properties": {
          "environment": {
            "const": "production"
          }
        }
      },
      "then": {
        "required": [
          "certAlert"
        ],
        "properties": {
          "certAlert": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "api": {
            "properties": {
              "image": {
                "required": [
                  "digest"
                ],
                "properties": {
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                }
              }
            }
          },
          "web": {
            "properties": {
              "image": {
                "required": [
                  "digest"
                ],
                "properties": {
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
