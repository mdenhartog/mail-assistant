{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "docker:pinDigests", "helpers:pinGitHubActionDigests"],
  "labels": ["dependencies"],
  "packageRules": [
    { "matchPackageNames": ["*"], "minimumReleaseAge": "7 days", "description": "dependency cooldown (ADR-0022)" },
    { "matchUpdateTypes": ["minor", "patch"], "groupName": "non-major dependencies" },
    { "matchPackageNames": ["typescript"], "allowedVersions": "<7", "description": "typescript-eslint support required (guardrail-typescript)" }
  ],
  "vulnerabilityAlerts": { "enabled": true, "minimumReleaseAge": null }
}
