{
  "components": {
    "schemas": {
      "Conflict409": {
        "additionalProperties": false,
        "description": "The 409 body of the write route: the current settings.",
        "properties": {
          "current": {
            "$ref": "#/components/schemas/Settings"
          },
          "status": {
            "const": 409,
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "current"
        ],
        "title": "Conflict409",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Probe result.",
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Place": {
        "additionalProperties": false,
        "description": "One selectable time zone.",
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "utcOffsetMinutes": {
            "title": "Utcoffsetminutes",
            "type": "integer"
          },
          "zone": {
            "title": "Zone",
            "type": "string"
          }
        },
        "required": [
          "zone",
          "label",
          "utcOffsetMinutes"
        ],
        "title": "Place",
        "type": "object"
      },
      "PlaceResults": {
        "additionalProperties": false,
        "description": "Up to five places, or a near-miss suggestion, or neither.",
        "properties": {
          "places": {
            "items": {
              "$ref": "#/components/schemas/Place"
            },
            "title": "Places",
            "type": "array"
          },
          "suggestion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggestion"
          }
        },
        "required": [
          "places"
        ],
        "title": "PlaceResults",
        "type": "object"
      },
      "Problem422": {
        "additionalProperties": false,
        "description": "The 422 body of the write route.",
        "properties": {
          "problems": {
            "items": {
              "$ref": "#/components/schemas/ProblemItem"
            },
            "title": "Problems",
            "type": "array"
          },
          "status": {
            "const": 422,
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "problems"
        ],
        "title": "Problem422",
        "type": "object"
      },
      "ProblemItem": {
        "additionalProperties": false,
        "description": "One refused field.",
        "properties": {
          "example": {
            "title": "Example",
            "type": "string"
          },
          "field": {
            "title": "Field",
            "type": "string"
          },
          "rule": {
            "title": "Rule",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "field",
          "rule",
          "value",
          "example"
        ],
        "title": "ProblemItem",
        "type": "object"
      },
      "RequestCodeBody": {
        "additionalProperties": false,
        "description": "The username a code is asked for: 1 to 64 characters, no control characters.",
        "properties": {
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username"
        ],
        "title": "RequestCodeBody",
        "type": "object"
      },
      "RequestCodeResponse": {
        "description": "The same answer for every username.",
        "properties": {
          "expiresAt": {
            "format": "date-time",
            "title": "Expiresat",
            "type": "string"
          },
          "maskedAddress": {
            "title": "Maskedaddress",
            "type": "string"
          },
          "resendAfterSeconds": {
            "title": "Resendafterseconds",
            "type": "integer"
          }
        },
        "required": [
          "maskedAddress",
          "expiresAt",
          "resendAfterSeconds"
        ],
        "title": "RequestCodeResponse",
        "type": "object"
      },
      "SessionInfo": {
        "additionalProperties": false,
        "description": "What the page needs to know about the signed-in session; no username and no full address.",
        "properties": {
          "absoluteExpiresAt": {
            "format": "date-time",
            "title": "Absoluteexpiresat",
            "type": "string"
          },
          "csrfToken": {
            "title": "Csrftoken",
            "type": "string"
          },
          "idleExpiresAt": {
            "format": "date-time",
            "title": "Idleexpiresat",
            "type": "string"
          },
          "maskedAddress": {
            "title": "Maskedaddress",
            "type": "string"
          },
          "noticeIntervalMinutes": {
            "title": "Noticeintervalminutes",
            "type": "integer"
          }
        },
        "required": [
          "maskedAddress",
          "csrfToken",
          "idleExpiresAt",
          "absoluteExpiresAt",
          "noticeIntervalMinutes"
        ],
        "title": "SessionInfo",
        "type": "object"
      },
      "Settings": {
        "additionalProperties": false,
        "description": "What ``GET /api/settings`` returns; never the actor.",
        "properties": {
          "updatedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updatedat"
          },
          "updatedVia": {
            "anyOf": [
              {
                "enum": [
                  "telegram",
                  "web"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updatedvia"
          },
          "values": {
            "$ref": "#/components/schemas/SettingsValues"
          },
          "version": {
            "minimum": 0.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "values",
          "version",
          "updatedAt",
          "updatedVia"
        ],
        "title": "Settings",
        "type": "object"
      },
      "SettingsReset": {
        "additionalProperties": false,
        "description": "The body of the reset route (U-web-settings-45): only the version the reset is based on.",
        "properties": {
          "version": {
            "minimum": 0.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version"
        ],
        "title": "SettingsReset",
        "type": "object"
      },
      "SettingsUpdate": {
        "additionalProperties": false,
        "description": "The body of the write route (U-web-settings-22): new values and the version they were based on.",
        "properties": {
          "values": {
            "$ref": "#/components/schemas/SettingsValues"
          },
          "version": {
            "minimum": 0.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "values",
          "version"
        ],
        "title": "SettingsUpdate",
        "type": "object"
      },
      "SettingsValues": {
        "additionalProperties": false,
        "description": "The five values of the schedule; times are ``HH:MM`` wall-clock times in ``time_zone``.",
        "properties": {
          "overviewAt": {
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "title": "Overviewat",
            "type": "string"
          },
          "quietEnd": {
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "title": "Quietend",
            "type": "string"
          },
          "quietStart": {
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "title": "Quietstart",
            "type": "string"
          },
          "remindAt": {
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "title": "Remindat",
            "type": "string"
          },
          "timeZone": {
            "maxLength": 64,
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "timeZone",
          "quietStart",
          "quietEnd",
          "overviewAt",
          "remindAt"
        ],
        "title": "SettingsValues",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Mail Assistant",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/places": {
      "get": {
        "description": "Find time zones for a typed place name, with the same lookup and aliases as Telegram.\n\nThe query is validated before matching and is never logged.\n\nArgs:\n    request: The request; its clock gives the moment the UTC offsets are computed for.\n    q: The typed text, at most 64 characters, no control characters.\n\nReturns:\n    Up to five places, or a suggestion for a near miss, or neither.",
        "operationId": "search_places_api_places_get",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "maxLength": 64,
              "pattern": "^[^\\x00-\\x1f\\x7f]*$",
              "title": "Q",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceResults"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No live session"
          },
          "422": {
            "description": "Query too long or invalid"
          },
          "429": {
            "description": "Too many requests; see Retry-After"
          }
        },
        "summary": "Search Places",
        "tags": [
          "places"
        ]
      }
    },
    "/api/session": {
      "get": {
        "description": "Return the masked address, the CSRF token and the expiry times of the session.\n\nOnly a same-origin request (``Sec-Fetch-Site`` absent or ``same-origin``) gets the token.\n\nArgs:\n    request: The request.\n    current: The live session.\n\nReturns:\n    The session information.\n\nRaises:\n    ProblemError: 403 (through ``refuse``) for a request that is not same-origin.",
        "operationId": "read_session_api_session_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No live session"
          },
          "403": {
            "description": "Not a same-origin request"
          },
          "429": {
            "description": "Too many requests; see Retry-After"
          }
        },
        "summary": "Read Session",
        "tags": [
          "session"
        ]
      }
    },
    "/api/settings": {
      "get": {
        "description": "Return the stored settings, or the defaults at version 0 when nothing is stored yet.\n\nArgs:\n    request: The request, whose app holds the database access.\n\nReturns:\n    The settings; the actor of the last change is never part of it.",
        "operationId": "read_settings_api_settings_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No live session"
          },
          "429": {
            "description": "Too many requests; see Retry-After"
          }
        },
        "summary": "Read Settings",
        "tags": [
          "settings"
        ]
      },
      "put": {
        "description": "Validate the whole row and store it if it is still at the version the change is based on.\n\nArgs:\n    body: The new values and the version they are based on.\n    request: The request, whose app holds the database access.\n    current: The live session; its keyed digest is the actor of the change.\n\nReturns:\n    The stored settings at the next version, or a 409 with the current settings, or a 422 with the problems.",
        "operationId": "write_settings_api_settings_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No live session"
          },
          "403": {
            "description": "Missing or wrong token, wrong Origin or cross-site request"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conflict409"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Conflict409"
                }
              }
            },
            "description": "The settings changed since the version sent; carries the current"
          },
          "415": {
            "description": "The body is not JSON"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem422"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem422"
                }
              }
            },
            "description": "A value is refused; the field, rule, value and an example"
          },
          "429": {
            "description": "Too many requests; see Retry-After"
          },
          "500": {
            "description": "The change could not be stored"
          }
        },
        "summary": "Write Settings",
        "tags": [
          "settings"
        ]
      }
    },
    "/api/settings/reset": {
      "post": {
        "description": "Replace the stored values, the time zone included, with the defaults if the row is still at the version.\n\nArgs:\n    body: The version the reset is based on.\n    request: The request, whose app holds the database access.\n    current: The live session; its keyed digest is the actor of the change.\n\nReturns:\n    The stored defaults at the next version, or a 409 with the current settings.",
        "operationId": "reset_settings_api_settings_reset_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsReset"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No live session"
          },
          "403": {
            "description": "Missing or wrong token, wrong Origin or cross-site request"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conflict409"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Conflict409"
                }
              }
            },
            "description": "The settings changed since the version sent; carries the current"
          },
          "415": {
            "description": "The body is not JSON"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Too many requests; see Retry-After"
          },
          "500": {
            "description": "The change could not be stored"
          }
        },
        "summary": "Reset Settings",
        "tags": [
          "settings"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "description": "End the session on the server and clear the cookie.\n\nArgs:\n    request: The request; its cookie names the session to delete.\n\nReturns:\n    An empty 204 that clears the ``__Host-session`` cookie.",
        "operationId": "logout_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "No live session"
          },
          "403": {
            "description": "CSRF check failed"
          },
          "429": {
            "description": "Too many requests; see Retry-After"
          }
        },
        "summary": "Logout",
        "tags": [
          "session"
        ]
      }
    },
    "/auth/request-code": {
      "post": {
        "description": "Ask for a sign-in code; the answer and the cookie are the same for every username.\n\nArgs:\n    body: The username.\n    request: The request.\n    response: The response, which gets the login cookie.\n    background: Sends the message after the answer.\n    service: The use case.\n\nReturns:\n    The masked address, the expiry and the wait before the next request.",
        "operationId": "request_code_auth_request_code_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestCodeBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestCodeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "description": "Wrong or missing Origin"
          },
          "422": {
            "description": "Invalid username"
          },
          "429": {
            "description": "Cooldown or hourly cap; see Retry-After"
          }
        },
        "summary": "Request Code",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/verify-code": {
      "post": {
        "description": "Check the code and sign in; every failure is the same 400.\n\nThe body is read here and checked by the use case, so a malformed body gets the same 400 as a wrong code.\n\nArgs:\n    request: The request, with the ``__Host-login`` cookie.\n\nReturns:\n    204 with the session cookie, or the generic 400.",
        "operationId": "verify_code_auth_verify_code_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "description": "The posted code and where the visitor wanted to go; the path is checked against an allow-list.",
                "properties": {
                  "code": {
                    "title": "Code",
                    "type": "string"
                  },
                  "returnTo": {
                    "anyOf": [
                      {
                        "maxLength": 2048,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Returnto"
                  }
                },
                "required": [
                  "code"
                ],
                "title": "VerifyCodeBody",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Signed in: the session cookie is set; the path to go to is in the X-Return-To header",
            "headers": {
              "X-Return-To": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "The one generic refusal; attemptsLeft is present whenever the login cookie names a real or decoy login request"
          },
          "403": {
            "description": "Wrong or missing Origin"
          },
          "429": {
            "description": "Too many attempts; see Retry-After"
          }
        },
        "summary": "Verify Code",
        "tags": [
          "auth"
        ]
      }
    },
    "/healthz": {
      "get": {
        "description": "Report that the process is alive.\n\nReturns:\n    A fixed ``ok`` status.",
        "operationId": "liveness_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Report that the service can accept traffic: the database answers and speaks the expected contract.\n\nAn app without a database is not ready: readiness is never fail-open.\n\nArgs:\n    request: The request, whose app holds the database access.\n\nReturns:\n    A fixed ``ok`` status.\n\nRaises:\n    HTTPException: 503 with a generic body when the database is down or its contract version differs.",
        "operationId": "readiness_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "Not ready"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    }
  }
}
