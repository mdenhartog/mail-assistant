# Copied to .env by the scaffolder with random local values. Never commit .env.
POSTGRES_PASSWORD=change-me-local-only
# Host ports (change when they collide with other software on your machine)
DB_PORT=5432
MAIL_PORT=8025
API_DEV_PORT=8000
WEB_DEV_PORT=5173
WEB_PORT=8080

# tools: bearer token (32+ characters); the component refuses to start without it
MCP_AUTH_TOKEN_TOOLS=

# assistant: bearer token (32+ characters); the component refuses to start without it
AGENT_AUTH_TOKEN_ASSISTANT=

# ---------------------------------------------------------------------------------------------------------------
# mail-triage: the agent refuses to start without the settings below that have an empty value.
# Never commit real values. Copy this file to .env (git ignores it) and fill it in.
# ---------------------------------------------------------------------------------------------------------------

# Anthropic API key (console.anthropic.com > API keys). Looks like sk-ant-...
ANTHROPIC_API_KEY=
# Model ids for the small first pass and the larger second opinion. Take them from the Anthropic model list;
# they are configuration on purpose, never hard-coded.
MAIL_TRIAGE_MODEL_SMALL=
MAIL_TRIAGE_MODEL_LARGE=

# Telegram bot token. Create a bot in Telegram: open a chat with @BotFather, send /newbot, follow the steps; it
# replies with the token (123456:ABC...). Then open a chat with your new bot and press Start once.
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram user id (message @userinfobot to read it). It is the only person the bot listens to.
TELEGRAM_ALLOWED_USER_ID=
# The id of your private chat with the bot. For a private chat it is the same number as your user id.
TELEGRAM_ALLOWED_CHAT_ID=

# Google OAuth client of type "Desktop app" (Google Cloud console > APIs & Services > Credentials), with the Gmail
# API enabled and your own Google account added as a test user on the consent screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Key that encrypts the stored Gmail refresh token. Generate one Fernet key and keep it safe (lose it = run the
# consent again):  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAIL_TRIAGE_TOKEN_ENCRYPTION_KEY=

# Database. Leave empty for the local compose database (uses POSTGRES_PASSWORD above). In production, set a full
# URL such as postgresql+asyncpg://user:password@host:5432/dbname
MAIL_TRIAGE_DATABASE_URL=
# Password of the database role mail_triage_runtime that the agent runs with (set by the migrate job)
MAIL_TRIAGE_RUNTIME_PASSWORD=

# One-time Gmail consent, once the settings above are filled in and the database is up (run in agents/mail-triage):
#   uv run python -m app.consent
# It opens your browser, asks for the three Gmail permissions and stores the token encrypted in the database.

# Optional tuning. The values after = are the defaults; remove the # to change one.
# MAIL_TRIAGE_POLL_INTERVAL_SECONDS=60
# MAIL_TRIAGE_DAILY_MODEL_BUDGET=200
# MAIL_TRIAGE_ALERTS_PER_HOUR=5
